# Fluent — configuració VIVA d'aquesta màquina (railab: RTX 4090 + 3090).
# No copiar entre màquines sense revisar: canviar amb .env.rapve segons on siguis.
#   cp .env.rapve .env   # a la 4060 ·  cp .env.railab .env   # aquí
# Totes les variables són sobreescrivibles per entorn
# (export VAR=... scripts/flowed-start.sh) o per CLI (--gpu ...).

# --- deep (14B; el que funciona) ---------------------------------------------
# BACKEND: native (llama-*.sh) | docker (docker-llama.sh, --gpus all)
FLOWED_DEEP_BACKEND=native
FLOWED_DEEP_MANAGED=1
FLOWED_DEEP_MODEL=/home/albert/aidev/models/Qwen3-14B-Q4_K_M.gguf
FLOWED_DEEP_PORT=12322
FLOWED_DEEP_GPU=1
# FLOWED_DEEP_CTX: ara viu a config/fluent.json (models.deep.ctx), amb kv_type.
# Les dues maquines fan servir el mateix context, aixi que ja no es un valor
# per maquina; deixar-lo aqui el tornaria a fixar a 32768 (l'.env mana sobre
# el config). Descomenta'l nomes si aquesta maquina ha de diferir de debo.
# FLOWED_DEEP_CTX=32768
# URLs explícites (opcional): buides = l'start les deriva del port amb
# 127.0.0.1. Posar-les només per a model remot (IP).
#FLOWED_DEEP_BASE_URL=http://127.0.0.1:12322/v1
#FLOWED_FACE_BASE_URL=http://127.0.0.1:12323/v1
# Manager del model DEFAULT (només backend=docker): script amb interfície
# start|stop|status. L'start l'atura (swap 1:1 de port); l'stop el restaura.
#FLOWED_DEFAULT_MANAGER=/home/albert/aidev/scripts/docker-llama-default.sh

# --- face/fast (opcional; 0 = no es puja, el deep el cobreix via fallback) ----
FLOWED_FACE_ENABLED=0
FLOWED_FACE_MODEL=/home/albert/aidev/models/Qwen3-1.7B-UD-Q4_K_XL.gguf
FLOWED_FACE_PORT=12323
FLOWED_FACE_GPU=1
FLOWED_FACE_CTX=32768

# --- webs: "perfil:port" separats per espais ----------------------------------
# Un perfil per alumne, amb el seu port. Els perfils viuen a ~/.flowed/<id>/ (o on digui FLOWED_HOME; ~/.fluent mentre no es mogui).
FLOWED_WEBS="alex-en:4100 sam-en:4101 demo-en:4102"
