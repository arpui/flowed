# Fluent — plantilla rapve (RTX 4060 Ti 16GB, model via Docker gestionat).
# Activar: cp .env.rapve .env
# L'start comprova /health i només llança el contenidor si no respon.

# --- deep (gestionat: MANAGED=1 + BACKEND=docker -> docker-llama.sh) ----------
FLUENT_DEEP_BACKEND=docker
FLUENT_DEEP_MANAGED=1
FLUENT_DEEP_MODEL=/home/albert/aidev/models/Qwen3-14B-Q4_K_M.gguf
FLUENT_DEEP_PORT=12321
# FLUENT_DEEP_CTX: ara viu a config/fluent.json (models.deep.ctx), amb kv_type.
# Les dues maquines fan servir el mateix context, aixi que ja no es un valor
# per maquina; deixar-lo aqui el tornaria a fixar a 32768 (l'.env mana sobre
# el config). Descomenta'l nomes si aquesta maquina ha de diferir de debo.
# FLUENT_DEEP_CTX=32768
# URL explícita (opcional): si buida, l'start la deriva com
# http://127.0.0.1:$FLUENT_DEEP_PORT/v1. Posar-la només per a model remot (IP).
#FLUENT_DEEP_BASE_URL=http://192.168.31.102:12321/v1
# Directori de models DINS la màquina rapve (muntat al contenidor)
FLUENT_MODEL_DIR=/home/albert/aidev/models

# Manager del model DEFAULT (independent del nostre; només interfície
# start|stop|status). L'start l'atura (stop) abans de pujar el nostre al
# mateix port; l'stop el torna a pujar (start) sempre.
FLUENT_DEFAULT_MANAGER=/home/albert/aidev/scripts/docker-llama-default.sh

# --- face/fast (opcional) ------------------------------------------------------
FLUENT_FACE_ENABLED=0
FLUENT_FACE_MODEL=/home/albert/aidev/models/Qwen3-1.7B-UD-Q4_K_XL.gguf
FLUENT_FACE_PORT=12323
FLUENT_FACE_GPU=0
FLUENT_FACE_CTX=16384

# --- webs ----------------------------------------------------------------------
# Un perfil per alumne, amb el seu port. Els perfils viuen a ~/.fluent/<id>/.
FLUENT_WEBS="alex-en:4100 sam-en:4101 demo-en:4102"
