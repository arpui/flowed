{
  "_note": [
    "Fluent model endpoints — LOCAL to this project copy. Copy this file to",
    "fluent-models.json and adjust. Do NOT copy config/ across machines",
    "without reviewing: ports, GPUs and model files differ per machine.",
    "Load order (later wins): code defaults <- .opencode/fluent-models.json",
    "(legacy) <- config/fluent-models.json <- $FLUENT_MODELS_FILE."
  ],
  "deep": {
    "provider": "fluent-deep",
    "model": "deep",
    "baseURL": "http://127.0.0.1:12322/v1",
    "temperature": 0.2,
    "max_tokens": 4096,
    "timeout_ms": 600000
  },
  "face": {
    "provider": "llama-face",
    "model": "face",
    "baseURL": "http://127.0.0.1:12323/v1",
    "temperature": 0.7,
    "max_tokens": 4096,
    "timeout_ms": 120000
  }
}
